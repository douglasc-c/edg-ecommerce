PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
NODE_ENV=development
DB_PATH=./data/commerce.db
STORE_NAME=EDG Commerce
ADMIN_EMAIL=admin@example.com
# Defina uma senha exclusiva com pelo menos 12 caracteres antes de executar seed.
ADMIN_PASSWORD=
# demo: fretes e pagamentos simulados, identificados na interface. live: APIs reais.
COMMERCE_MODE=demo
RESERVATION_MINUTES=30
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
MELHOR_ENVIO_TOKEN=
# Secret do aplicativo integrado; necessário para receber atualizações automáticas.
MELHOR_ENVIO_WEBHOOK_SECRET=
MELHOR_ENVIO_SANDBOX=true
SUPPORT_EMAIL=
ORIGIN_POSTAL_CODE=
# JSON do remetente conforme documentação: name, phone, email, document, address,
# number, complement, district, city, state_abbr, country_id=BR, postal_code
SHIPPING_FROM_JSON=

# Recuperação de senha por e-mail (Resend). Verifique o domínio remetente no provedor.
RESEND_API_KEY=
EMAIL_FROM=
# Chave estável de 32 bytes em hexadecimal; gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=
# NF-e (mercadorias), via Focus NFe. Comece pelo ambiente de homologação.
FOCUS_NFE_TOKEN=
NFE_ENVIRONMENT=homologation
# Campos do emitente no formato Focus NFe, incluindo CNPJ, IE, regime e endereço.
NFE_EMITTER_JSON=
# Parâmetros fiscais revisados pela contabilidade (natureza, modalidade de frete, consumidor final, indicador IE etc.).
NFE_DEFAULTS_JSON=

# Catálogo real sem checkout: COMMERCE_MODE=catalog
# Moeda do catálogo (BRL ou EUR). Não converte preços existentes.
STORE_CURRENCY=BRL
