PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
NODE_ENV=development
DB_PATH=./data/commerce.db
STORE_NAME=EDG Commerce
ADMIN_EMAIL=admin.edg@skateboards.com
# Define una contraseña exclusiva de al menos 12 caracteres antes de ejecutar el seed.
ADMIN_PASSWORD=TU CONTRASEÑA AQUÍ
# demo: envíos y pagos simulados, identificados en la interfaz. live: API reales.
COMMERCE_MODE=demo
RESERVATION_MINUTES=30
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
MELHOR_ENVIO_TOKEN=
# Secreto de la aplicación integrada; necesario para recibir actualizaciones automáticas.
MELHOR_ENVIO_WEBHOOK_SECRET=
MELHOR_ENVIO_SANDBOX=true
SUPPORT_EMAIL=
ORIGIN_POSTAL_CODE=
# JSON del remitente según la documentación: name, phone, email, document, address,
# number, complement, district, city, state_abbr, country_id=BR, postal_code
SHIPPING_FROM_JSON=

# Recuperación de contraseña por correo electrónico (Resend). Verifica el dominio remitente en el proveedor.
RESEND_API_KEY=
EMAIL_FROM=
# Clave estable de 32 bytes en hexadecimal; generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=
# NF-e brasileña (mercancías), mediante Focus NFe. Empieza por el entorno de homologación.
# Esta integración no emite facturas españolas ni implementa VERI*FACTU.
FOCUS_NFE_TOKEN=
NFE_ENVIRONMENT=homologation
# Campos del emisor en el formato de Focus NFe, incluidos CNPJ, IE, régimen y dirección.
NFE_EMITTER_JSON=
# Parámetros fiscales revisados por contabilidad (naturaleza, modalidad de envío, consumidor final, indicador IE, etc.).
NFE_DEFAULTS_JSON=

# Catálogo real sin proceso de compra: COMMERCE_MODE=catalog
# Moneda del catálogo (BRL o EUR). No convierte los precios existentes.
STORE_CURRENCY=BRL

# Envíos europeos manuales (Sendcloud), independientes del proceso de compra brasileño.
# Para la tienda europea, sustituye los valores anteriores por:
# COMMERCE_MODE=catalog
# STORE_CURRENCY=EUR
# SHIPPING_PROVIDER=sendcloud
# Sin SHIPPING_PROVIDER explícito: EUR selecciona Sendcloud y BRL selecciona Melhor Envio.
# test: creación simulada solo en local, sin anunciar envíos ni generar etiquetas reales.
# Las consultas de conexión, remitentes y tarifas sí usan la API real y requieren credenciales.
SENDCLOUD_ENVIRONMENT=test
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Opcional: misma Webhook Signature Key configurada en Sendcloud; si falta, se usa la Secret Key.
SENDCLOUD_WEBHOOK_SECRET=
# ID numérico de la dirección de remitente de Barcelona (ES) en esta cuenta.
SENDCLOUD_SENDER_ADDRESS_ID=
# Cambiar a SENDCLOUD_ENVIRONMENT=live permite contratar tras confirmar en la interfaz.
# No habilita el pago en EUR ni modifica existencias o finanzas.

# Checkout EUR optativo: ver EUROPE_CHECKOUT.md. Usa un almacén separado en pruebas.
EUROPE_CHECKOUT_ENABLED=false
PAYMENT_ENVIRONMENT=test
BANK_TRANSFER_BANK=Banco Sabadell
BANK_TRANSFER_BENEFICIARY=EDG SKATEBOARDS S.L.
BANK_TRANSFER_IBAN=
BANK_TRANSFER_RESERVATION_HOURS=72
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
