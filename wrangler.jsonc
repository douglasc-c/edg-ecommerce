{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edg-ecommerce",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Conserva las variables añadidas solo desde el panel entre despliegues.
  "keep_vars": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "alias": {
    "./db.mjs": "./cloudflare/database.mjs",
    "./image-processor.mjs": "./cloudflare/image-processor.mjs"
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "CommerceStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CommerceStore"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "COMMERCE_MODE": "catalog",
    "STORE_NAME": "EDG Commerce",
    "STORE_CURRENCY": "EUR",
    "SHIPPING_PROVIDER": "sendcloud",
    "SENDCLOUD_ENVIRONMENT": "test"
  },
  "observability": { "enabled": true }
}
