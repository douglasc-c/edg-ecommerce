{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edg-ecommerce",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Conserva las variables añadidas solo desde el panel entre despliegues.
  "keep_vars": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "alias": {
    "./db.mjs": "./cloudflare/database.mjs",
    "./image-processor.mjs": "./cloudflare/image-processor.mjs"
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "CommerceStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CommerceStore"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_URL": "https://www.edgskateboards.com",
    "COMMERCE_MODE": "catalog",
    "STORE_NAME": "EDG Commerce",
    "STORE_CURRENCY": "EUR",
    "SHIPPING_PROVIDER": "sendcloud",
    "SENDCLOUD_ENVIRONMENT": "live",
    "EUROPE_CHECKOUT_ENABLED": "true",
    "PAYMENT_ENVIRONMENT": "live",
    "BANK_TRANSFER_BANK": "Banco Sabadell",
    "BANK_TRANSFER_BENEFICIARY": "EDG SKATEBOARDS S.L.",
    "BANK_TRANSFER_RESERVATION_HOURS": "72"
  },
  // Producción EUR: conserva COMMERCE_MODE=catalog; live es el flujo brasileño.
  // Antes de publicar este archivo, configura las claves LIVE y las variables
  // de entorno en una sola edición de Cloudflare. Consulta PRODUCTION.md.
  // Secretos del checkout EUR (añadir como Secret; no poner sus valores en vars):
  // STRIPE_SECRET_KEY: clave sk_live_... o rk_live_... de producción.
  // STRIPE_WEBHOOK_SECRET: firma whsec_... del endpoint LIVE /api/webhooks/stripe.
  // BANK_TRANSFER_IBAN: IBAN español completo de 24 caracteres, verificado con el banco.
  // Secretos del Worker (panel de Cloudflare o `npx wrangler secret put NOMBRE`):
  // ADMIN_EMAIL, ADMIN_PASSWORD, SENDCLOUD_PUBLIC_KEY, SENDCLOUD_SECRET_KEY,
  // SENDCLOUD_SENDER_ADDRESS_ID. Sus valores no se incluyen en este archivo.
  "observability": { "enabled": true }
}
